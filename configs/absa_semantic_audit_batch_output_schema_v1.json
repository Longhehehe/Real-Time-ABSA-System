{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "annotation_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "NO_MATERIAL_ISSUE",
              "MINOR_OR_BOUNDARY",
              "MAJOR"
            ],
            "type": "string"
          }
        },
        "required": [
          "annotation_id",
          "severity",
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "records"
  ],
  "type": "object"
}
