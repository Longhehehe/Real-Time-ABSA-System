        "ROOMS#PRICES",
        "ROOMS#QUALITY",
        "ROOM_AMENITIES#CLEANLINESS",
        "ROOM_AMENITIES#COMFORT",
        "ROOM_AMENITIES#DESIGN&FEATURES",
