{
  "schema_version": 1,
  "sentiment_order": ["NEG", "POS", "NEU"],
  "profiles": {
    "uit_visd4sa": {
      "task": "acsa",
      "loader": "uit_jsonl",
      "description": "UIT-ViSD4SA converted from span annotations to review-level ACSA.",
      "source_url": "https://github.com/kimkim00/UIT-ViSD4SA",
      "citation": "Thanh et al., Span Detection for Aspect-Based Sentiment Analysis in Vietnamese, PACLIC 2021.",
      "span_policy": "collapse_to_review_multi_polarity",
      "splits": {
        "train": "absa data/UIT-ViSD4SA-main/UIT-ViSD4SA-main/data/train.jsonl",
        "dev": "absa data/UIT-ViSD4SA-main/UIT-ViSD4SA-main/data/dev.jsonl",
        "test": "absa data/UIT-ViSD4SA-main/UIT-ViSD4SA-main/data/test.jsonl"
      },
      "aspects": [
        "BATTERY",
        "CAMERA",
        "DESIGN",
        "FEATURES",
        "GENERAL",
        "PERFORMANCE",
        "PRICE",
        "SCREEN",
        "SER&ACC",
        "STORAGE"
      ],
      "polarity_map": {
        "NEGATIVE": "NEG",
        "POSITIVE": "POS",
        "NEUTRAL": "NEU"
      }
    },
